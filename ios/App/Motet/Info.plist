<?xml version="1.0" encoding="UTF-8"?>
<!--
  The keys that make this a podcast player rather than a foreground app:

  * `UIBackgroundModes: audio` — without it iOS stops the audio the moment the phone is
    locked or pocketed, which is the entire listening situation this app exists for.
  * `CPTemplateApplicationSceneSessionRoleApplication` — the CarPlay scene. It is inert
    until the `com.apple.developer.carplay-audio` entitlement is granted by Apple.
  * `NSAppTransportSecurity` is deliberately absent: the API is reached over HTTPS, and an
    exception here would be a way to point the app at a plaintext host by accident.
  * `NSMicrophoneUsageDescription` — Play Live opens the mic. Without the key iOS terminates
    the app the first time it asks, rather than showing the permission prompt.

  And the ones App Store Connect reads on upload (`ios/bin/testflight` asserts each of them
  against the archived app, because the upload is the only other place they are checked):

  * The bundle identity keys, as build-setting references. `GENERATE_INFOPLIST_FILE` is off,
    so nothing adds them for us, and an app without `CFBundleExecutable` compiles cleanly
    and is refused at upload.
  * `CFBundleShortVersionString` / `CFBundleVersion` come from `MARKETING_VERSION` and
    `CURRENT_PROJECT_VERSION`, so the distribution workflow can give every upload a new
    build number without editing this file.
  * `ITSAppUsesNonExemptEncryption: false` — the app's only cryptography is HTTPS and the
    Keychain, both exempt. Without the key every build waits on an export-compliance
    question in App Store Connect before a tester can install it.
  * `MotetDefaultBaseURL` — the server a distribution build is pointed at, filled from the
    `MOTET_DEFAULT_API_BASE_URL` build setting. It is empty in this repo and in every CI
    build; the TestFlight workflow passes it from a GitHub environment variable, so no
    hostname is written here. Settings still overrides it.
  * `MotetAppLinkDomain` — the host this build's associated-domains entitlement names, from
    the `MOTET_APP_LINK_DOMAIN` build setting and empty everywhere the entitlement is not
    signed in. It is read at sign-in: asking the system sheet for an https callback on a
    host the build is *not* entitled for is refused by iOS, so the app offers that callback
    only for its own domain, whatever the API reports.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Motet</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>MotetDefaultBaseURL</key>
	<string>$(MOTET_DEFAULT_API_BASE_URL)</string>
	<key>MotetAppLinkDomain</key>
	<string>$(MOTET_APP_LINK_DOMAIN)</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Play Live listens while an episode plays, so you can interrupt it and ask a question out loud.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>CPTemplateApplicationScene</string>
					<key>UISceneConfigurationName</key>
					<string>CarPlay</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
