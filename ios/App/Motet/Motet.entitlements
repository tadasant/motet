<?xml version="1.0" encoding="UTF-8"?>
<!--
  `com.apple.developer.carplay-audio` is not a checkbox: Apple grants it by manual review,
  after Developer Program enrolment, and the request can take weeks. Until it is granted,
  **this file must not be set as the target's CODE_SIGN_ENTITLEMENTS** — an ungranted
  entitlement makes the build fail to sign rather than merely lack CarPlay. The Xcode
  project therefore ships with no entitlements file wired up, and `ios/README.md` says
  which build setting to point at this file once the grant arrives.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.carplay-audio</key>
	<true/>
</dict>
</plist>
