#!/usr/bin/env bash
#
# Drive the app on a booted simulator and collect the evidence.
#
# THIS IS THE ONLY THING IN THE PROJECT THAT RUNS THE APP. `bin/ci` tests the logic where
# AVFoundation does not exist, `ios/bin/build-app` compiles and links without booting
# anything, and `ios/bin/testflight check` archives. None of them can answer the one
# question the app could never answer about itself — is sound actually coming out — because
# that question has no answer from outside the process either: no cloud device service
# captures iOS audio, so it has to be measured inside the app and read by something that
# runs it. This is that something.
#
# Its own script rather than YAML, for the reason every other check here is a script: a
# check that exists only in a workflow cannot be run by hand and will rot. The
# `ios-ui-tests.yml` workflow's whole body is a call to this, and the `ios` job in `ci.yml`
# calls exactly the same line.
#
# NOTHING HERE SIGNS ANYTHING and nothing here holds a credential: a simulator build needs
# no identity, and the app under test signs into nothing (an agent cannot complete a Google
# sign-in — AGENTS.md says so — so the flow drives a Debug-only fixture screen instead).
#
# Usage:
#   ios/bin/ui-test                                       # Debug, no default server
#   ios/bin/ui-test --configuration Staging \
#                   --api-base-url https://example.test   # the staging variant
#   ios/bin/ui-test --artifacts out/                      # where video and results land
#
# NO HOSTNAME IS WRITTEN IN THIS REPOSITORY. `--api-base-url` defaults to
# $MOTET_IOS_API_BASE_URL, so a workflow sets one variable and this file names nothing.
set -euo pipefail

cd "$(dirname "$0")/.."

configuration=Debug
base_url="${MOTET_IOS_API_BASE_URL:-}"
artifacts="${MOTET_UI_TEST_ARTIFACTS:-$PWD/.ui-test}"

while [ $# -gt 0 ]; do
  case "$1" in
    --configuration) configuration="${2:?--configuration needs a value}"; shift 2 ;;
    --api-base-url) base_url="${2:?--api-base-url needs a value}"; shift 2 ;;
    --artifacts) artifacts="${2:?--artifacts needs a value}"; shift 2 ;;
    -h|--help) sed -n '2,30p' "$0"; exit 0 ;;
    *) printf 'unknown argument: %s\n' "$1" >&2; exit 2 ;;
  esac
done

fail() { printf '\n\033[1;31m==> FAILED: %s\033[0m\n\n' "$1" >&2; exit 1; }

# Matches PRODUCT_BUNDLE_IDENTIFIER in App/Motet.xcodeproj. Only used to relaunch the app
# for the screenshot below; the test run resolves it from the built product itself.
BUNDLE_ID=com.getmotet.app

case "$configuration" in
  Debug|Staging) ;;
  Release)
    # The fixture screen and the probe strip the test drives are `#if DEBUG`, so a Release
    # build has no UI for this to touch. Saying so beats twelve minutes and a confusing
    # "element not found".
    fail "Release strips the fixture this drives; use Debug or Staging" ;;
  *) fail "unknown configuration: $configuration (Debug, Staging)" ;;
esac

if [ -n "$base_url" ] && [ "${base_url#https://}" = "$base_url" ]; then
  fail "--api-base-url must be https://"
fi

if ! command -v xcodebuild >/dev/null 2>&1; then
  if [ -n "${CI:-}" ]; then
    fail "no Xcode in CI — this only runs on the macOS job. Refusing to report green on an app nothing ran."
  fi
  printf '\n\033[1;33m==> SKIPPED: the iOS UI tests (no Xcode)\033[0m\n'
  printf '    Needs a Mac with a simulator runtime. CI runs it on a GitHub-hosted macOS\n'
  printf '    runner; see ios/README.md.\n\n'
  exit 0
fi

# What the app is expected to report about itself, derived from what it is being built
# with — so the two sides of the assertion cannot drift.
case "$configuration" in
  Staging) expect_env=staging ;;
  Debug) expect_env=development ;;
esac
expect_host=""
if [ -n "$base_url" ]; then
  expect_host="$(printf '%s' "$base_url" | sed -e 's#^https://##' -e 's#[:/].*$##' | tr 'A-Z' 'a-z')"
fi

rm -rf "$artifacts"
mkdir -p "$artifacts"
derived="$artifacts/DerivedData"

printf '    using %s\n' "$(xcodebuild -version | head -1)"
printf '    configuration %s, default server %s\n' "$configuration" "${base_url:-none}"

# ---------------------------------------------------------------------------------------
# A simulator of our own, by UDID.
#
# Never `-destination 'platform=iOS Simulator,name=iPhone 15'`: which devices a hosted
# runner has is a moving target, and a name that is not there fails as "Unable to find a
# device matching the provided destination specifier" several minutes into a build. Asking
# `simctl` which devices exist and taking one is the version that keeps working when the
# image changes under us.
# ---------------------------------------------------------------------------------------
udid="$(xcrun simctl list devices available --json | python3 -c '
import json, sys

runtimes = json.load(sys.stdin)["devices"]
best = None
for runtime, devices in runtimes.items():
    if "iOS" not in runtime:
        continue
    for device in devices:
        if not device.get("isAvailable"):
            continue
        if "iPhone" not in device.get("name", ""):
            continue
        # A lexicographic max over (runtime, name). Deliberately NOT a "newest device"
        # claim — `iOS-17-5` sorts above `iOS-17-10` and `iPhone SE (3rd generation)`
        # above `iPhone 16 Pro Max`. What it guarantees is a *stable, available* pick with
        # no model hard-coded, so a runner image bump changes nothing here; which iPhone
        # runs the probe does not matter to what it measures.
        key = (runtime, device["name"])
        if best is None or key > best[0]:
            best = (key, device["udid"])
print(best[1] if best else "")
')"
[ -n "$udid" ] || fail "no available iPhone simulator; \`xcrun simctl list devices available\` shows none"
printf '    simulator %s\n' "$udid"

xcrun simctl boot "$udid" 2>/dev/null || true
xcrun simctl bootstatus "$udid" -b

recorder=""
cleanup() {
  # INT rather than TERM: `simctl io recordVideo` finalises the container on SIGINT and
  # leaves an unplayable file on SIGTERM, which is the difference between an artifact and
  # a zero-byte one.
  if [ -n "$recorder" ]; then kill -INT "$recorder" 2>/dev/null || true; wait "$recorder" 2>/dev/null || true; fi
  xcrun simctl shutdown "$udid" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# ---------------------------------------------------------------------------------------
# Build, then check the built bundle before running anything.
# ---------------------------------------------------------------------------------------
printf '==> building for testing\n'
xcodebuild build-for-testing \
  -project App/Motet.xcodeproj \
  -scheme MotetUITests \
  -configuration "$configuration" \
  -sdk iphonesimulator \
  -destination "id=$udid" \
  -derivedDataPath "$derived" \
  MOTET_DEFAULT_API_BASE_URL="$base_url" \
  CODE_SIGNING_ALLOWED=NO \
  CODE_SIGNING_REQUIRED=NO

# The substitution, proven from the artifact rather than from the command line.
#
# This is the half of "the staging variant resolves the staging API" that needs no test
# runner and no simulator: a build setting that never reached `Info.plist` is a build that
# would point at nothing, and it would look identical on the command line. The UI test
# proves the other half — what the *running* app made of these two keys.
plist="$derived/Build/Products/$configuration-iphonesimulator/Motet.app/Info.plist"
[ -f "$plist" ] || fail "no built Info.plist at $plist"
built_env="$(plutil -extract MotetBuildEnvironment raw -o - "$plist" 2>/dev/null || echo "")"
built_url="$(plutil -extract MotetDefaultBaseURL raw -o - "$plist" 2>/dev/null || echo "")"
printf '    built Info.plist: MotetBuildEnvironment=%s MotetDefaultBaseURL=%s\n' \
  "${built_env:-<empty>}" "${built_url:-<empty>}"
[ "$built_env" = "$expect_env" ] \
  || fail "built MotetBuildEnvironment is '$built_env', expected '$expect_env'"
[ "$built_url" = "$base_url" ] \
  || fail "built MotetDefaultBaseURL is '$built_url', expected '${base_url:-<empty>}'"
# Deliberately no host and no URL. This file is uploaded as a workflow artifact, an
# artifact on a public repository is downloadable by anyone, and `::add-mask::` does
# nothing to file contents. What the check needed the host for has already happened above;
# what is recorded is that it matched.
printf '%s\n' "env=$expect_env host_matched=$([ -n "$expect_host" ] && echo yes || echo 'no server')" \
  >"$artifacts/build-target.txt"

# ---------------------------------------------------------------------------------------
# Run, with the camera on.
# ---------------------------------------------------------------------------------------
# Both spellings, because how a test *runner* process is handed an environment variable has
# differed between Xcode versions, and the test treats an absent expectation as an
# abstention rather than a failure — the Info.plist check above is what keeps such a run
# from being evidence-free.
export MOTET_UI_TEST_EXPECT_ENV="$expect_env"
export MOTET_UI_TEST_EXPECT_HOST="$expect_host"
export TEST_RUNNER_MOTET_UI_TEST_EXPECT_ENV="$expect_env"
export TEST_RUNNER_MOTET_UI_TEST_EXPECT_HOST="$expect_host"

xcrun simctl io "$udid" recordVideo --codec h264 --force "$artifacts/run.mp4" &
recorder=$!

printf '==> running the UI tests\n'
status=0
xcodebuild test-without-building \
  -project App/Motet.xcodeproj \
  -scheme MotetUITests \
  -configuration "$configuration" \
  -sdk iphonesimulator \
  -destination "id=$udid" \
  -derivedDataPath "$derived" \
  -resultBundlePath "$artifacts/MotetUITests.xcresult" \
  -test-timeouts-enabled YES \
  -maximum-test-execution-time-allowance 300 \
  CODE_SIGNING_ALLOWED=NO \
  CODE_SIGNING_REQUIRED=NO || status=$?

# A screenshot whatever happened: on a red run it is the first thing worth looking at, and
# on a green one it is what a pull request embeds.
#
# TWO of them, because the obvious one is worthless on its own. XCUITest terminates the app
# when the run ends, so a `simctl` screenshot taken here catches the springboard — which is
# what the first version of this did. So the app is relaunched with the probe screen on
# autoplay and photographed while it is actually playing; `simctl` can screenshot and
# cannot tap, which is the whole reason that launch argument exists.
xcrun simctl io "$udid" screenshot "$artifacts/last-screen.png" 2>/dev/null || true

app="$derived/Build/Products/$configuration-iphonesimulator/Motet.app"
if [ -d "$app" ]; then
  printf '==> photographing the probe screen, idle and then playing\n'
  xcrun simctl install "$udid" "$app" >/dev/null 2>&1 || true

  # A PAIR, because one of them proves nothing on its own: a probe hard-wired to
  # "AUDIBLE" would take the second picture and a probe hard-wired to "SILENT" would take
  # the first. The signal *changing* is the claim, and it is the same claim
  # `test_the_playback_signal_moves_between_playing_and_paused` makes — this is what it
  # looks like.
  xcrun simctl launch "$udid" "$BUNDLE_ID" -MotetPlaybackProbe >/dev/null 2>&1 || true
  /bin/sleep 6
  xcrun simctl io "$udid" screenshot "$artifacts/probe-idle.png" 2>/dev/null || true
  xcrun simctl terminate "$udid" "$BUNDLE_ID" >/dev/null 2>&1 || true

  xcrun simctl launch "$udid" "$BUNDLE_ID" \
    -MotetPlaybackProbe -MotetPlaybackProbeAutoplay >/dev/null 2>&1 || true
  # Long enough for the tone to be written, the item to become ready, the tap to install
  # and `PlaybackClockWatch`'s window to fill — the last of which is what makes the
  # picture say AUDIBLE rather than "not judged yet".
  /bin/sleep 12
  xcrun simctl io "$udid" screenshot "$artifacts/probe-playing.png" 2>/dev/null || true
  xcrun simctl terminate "$udid" "$BUNDLE_ID" >/dev/null 2>&1 || true
fi

# The derived data is a gigabyte of object files nobody wants in an artifact bundle; the
# result bundle, the video and the three screenshots are the evidence.
rm -rf "$derived"

if [ "$status" -ne 0 ]; then
  fail "the UI tests did not pass (xcodebuild exit $status) — see $artifacts"
fi
printf '\n\033[1;32m==> the UI tests passed\033[0m\n    artifacts: %s\n\n' "$artifacts"
