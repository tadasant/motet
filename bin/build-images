#!/usr/bin/env bash
#
# Build the three container images Cloud Run runs — motet-api, motet-worker, motet-web —
# and prove each one actually serves, rather than merely that it built.
#
# Separate from bin/ci because it needs a Docker daemon, and bin/ci deliberately needs
# only Postgres: a laptop without Docker must still be able to run the full check suite.
# CI runs this as its own job, so the images cannot silently stop building.
#
# It does NOT push. This repo is public and holds no cloud credential of any kind (see
# AGENTS.md); publishing is the private infrastructure repo's job.
#
#     bin/build-images              # build and smoke-test all three
#     bin/build-images api web      # a subset
#     TAG=v1 bin/build-images       # pin the tag instead of the per-run default
set -euo pipefail

cd "$(dirname "$0")/.."

# Tagged per run, not `local`. The self-hosted pool is shared and `ci.yml` groups
# concurrency by ref, so a PR run and a push-to-main run overlap freely on one box —
# a fixed tag means one run retags the image another is about to smoke-test.
TAG="${TAG:-local-$$}"

step() { printf '\n\033[1m==> %s\033[0m\n' "$1"; }

# Every smoke container is named and torn down on exit, including the failure path —
# a leaked container holds its port and makes the next run fail for the wrong reason.
CONTAINERS=()
IMAGES=()
cleanup() {
  for name in "${CONTAINERS[@]:-}"; do
    [ -n "$name" ] && docker rm -f "$name" >/dev/null 2>&1 || true
  done
  # Only the tags this run created. A blanket `docker image prune` here would delete a
  # co-tenant job's dangling layers off the shared runner mid-build.
  for image in "${IMAGES[@]:-}"; do
    [ -n "$image" ] && docker rmi -f "$image" >/dev/null 2>&1 || true
  done
}
trap cleanup EXIT

# The host port Docker chose for a container's 8080. Ports are assigned by the daemon
# (`-P`) rather than hardcoded: two concurrent jobs on this shared runner would otherwise
# collide on a fixed port and fail for a reason unrelated to the change under test.
host_port() {
  docker port "$1" 8080 | head -1 | sed 's/.*://'
}

# Wait for a container's HTTP endpoint, then hand back the body. Polls rather than
# sleeping a fixed interval: a cold Python start is a second on a laptop and rather
# longer on a loaded shared runner.
wait_for_http() {
  local url="$1" name="$2" attempts=60
  for _ in $(seq "$attempts"); do
    if curl -fsS --max-time 2 "$url" 2>/dev/null; then
      return 0
    fi
    if [ -z "$(docker ps -q -f "name=^${name}$")" ]; then
      echo "smoke: container ${name} exited before serving ${url}" >&2
      docker logs "$name" >&2 || true
      return 1
    fi
    sleep 1
  done
  echo "smoke: ${url} did not answer within ${attempts}s" >&2
  docker logs "$name" >&2 || true
  return 1
}

# --- api -------------------------------------------------------------------
build_api() {
  IMAGES+=("motet-api:${TAG}")
  docker build --target api -t "motet-api:${TAG}" -f Dockerfile .
}

# Health lives here and NOT on /healthz. Cloud Run's frontend answers /healthz with its
# own HTML 404 before the request reaches the container, so the endpoint was unreachable
# in both deployed environments while this smoke test passed — see motet#16.
#
# READ THIS BEFORE TRUSTING THE CHECK BELOW. It runs the image under `docker run`, where
# there is no Google frontend in front of the container. So it proves the *application*
# serves health at this path without a database and without a vendor key, and it proves
# the path is not one we already know the platform eats. It proves NOTHING about what
# Google's frontend does with any given path — that is only observable against a deployed
# revision, and it is exactly the gap that let motet#16 ship green.
API_HEALTH_PATH="/internal/health"

# Mirrors motet_api.main.PLATFORM_RESERVED_PATHS. Two copies because this is shell and
# that is Python; keep them in step. The Python one is guarded by a test, this one is the
# same claim made against a real container.
PLATFORM_RESERVED_PATHS=("/healthz" "/_ah")

smoke_api() {
  local name="motet-smoke-api-$$" port
  CONTAINERS+=("$name")
  # No DATABASE_URL and no vendor key on purpose. Health must answer without either — it
  # is what Cloud Run's startup probe hits, and a health check that needed the database
  # would report the database's health rather than the revision's.
  #
  # The vault variables ARE set, and they are the exception that earns its keep. Sealing a
  # Gmail credential imports google-cloud-kms lazily, the SDK lived behind an optional
  # extra nothing depended on, and so every image shipped without it — visible nowhere
  # until a human finished a Google consent screen and the callback raised inside a
  # request. The key path is a throwaway string; nothing here calls Cloud KMS. What is on
  # trial is whether the SDK is in the *image*, which is the one claim the workspace's own
  # venv cannot make on the image's behalf. Same lesson as motet#16.
  docker run -d --name "$name" -P \
    -e MOTET_VAULT_BACKEND=kms \
    -e MOTET_VAULT_KMS_KEY=projects/smoke/locations/smoke/keyRings/smoke/cryptoKeys/smoke \
    "motet-api:${TAG}" >/dev/null
  port="$(host_port "$name")"

  local body
  body="$(wait_for_http "http://127.0.0.1:${port}${API_HEALTH_PATH}" "$name")"
  echo "    ${API_HEALTH_PATH} -> ${body}"
  case "$body" in
    *'"status":"ok"'*) ;;
    *) echo "smoke: ${API_HEALTH_PATH} did not report ok" >&2; return 1 ;;
  esac
  case "$body" in
    *'"vault_ready":true'*) ;;
    *) echo "smoke: the image cannot seal a credential — google-cloud-kms is missing" >&2
       return 1 ;;
  esac

  # And nothing may be served under a path the platform claims. A local 404 here is the
  # app's own JSON 404, not Google's — the point is not to reproduce the frontend, it is
  # to fail loudly if someone moves health back onto a path the frontend never forwards.
  local reserved code
  for reserved in "${PLATFORM_RESERVED_PATHS[@]}"; do
    # `|| true` rather than a bare curl: under `set -e` a connection failure inside a
    # command substitution would abort the script with curl's message instead of the one
    # below, which says what the check was actually for. curl still prints `000` itself
    # on a failure, so the empty case and the unreachable case both trip the test.
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 \
      "http://127.0.0.1:${port}${reserved}" || true)"
    echo "    ${reserved} -> ${code} (reserved by the platform; must not be ours)"
    if [ "$code" != "404" ]; then
      echo "smoke: the container answers ${reserved}, which Cloud Run 404s before it arrives" >&2
      return 1
    fi
  done

  # The generated contract has to be reachable too: it is what proves the app booted as
  # the real FastAPI application rather than as something that merely answers health.
  curl -fsS --max-time 5 "http://127.0.0.1:${port}/openapi.json" >/dev/null
  echo "    /openapi.json -> ok"
}

# --- worker ----------------------------------------------------------------
build_worker() {
  IMAGES+=("motet-worker:${TAG}")
  docker build --target worker -t "motet-worker:${TAG}" -f Dockerfile .
}

smoke_worker() {
  # The runner refuses an unknown queue name and exits non-zero, which makes `--help` the
  # only invocation that proves the entrypoint is wired without needing a database. It
  # also proves the queue choices, so a renamed queue shows up here.
  #
  # `2>&1` is load-bearing, and its absence is how motet#21 shipped green. The entrypoint
  # was double-executing — `__init__` imported the very module `python -m` runs, so runpy
  # executed it twice and said so — but it said so on *stderr* and still exited 0, so a
  # check that captured stdout alone could not see it. This is the only place the built
  # artifact's own interpreter and install layout are on trial; the workspace equivalent
  # is workers/tests/test_entrypoint.py.
  local usage
  usage="$(docker run --rm "motet-worker:${TAG}" --help 2>&1)"
  echo "$usage" | head -3 | sed 's/^/    /'
  case "$usage" in
    *"found in sys.modules"*)
      echo "smoke: the worker entry point double-executes itself (motet#21)" >&2; return 1 ;;
  esac
  case "$usage" in
    *integrate*assemble*script*tts*) ;;
    *) echo "smoke: worker --help did not list the Phase 1 queues" >&2; return 1 ;;
  esac

  # The migration entry point ships in this same image — `motet-workers` depends on
  # `motet-db` — and it had the identical defect for longer, because `bin/ci` ran it on
  # every single run and nobody saw the warning: it goes to stderr and the exit code stays
  # 0 (motet#27). Same `2>&1`, same reason. `--help` again, so no database is needed.
  local migrate_usage
  migrate_usage="$(docker run --rm --entrypoint python "motet-worker:${TAG}" \
    -m motet_db.migrate --help 2>&1)"
  case "$migrate_usage" in
    *"found in sys.modules"*)
      echo "smoke: the migrate entry point double-executes itself (motet#27)" >&2; return 1 ;;
  esac
  case "$migrate_usage" in
    "usage: motet-migrate"*) ;;
    *) echo "smoke: python -m motet_db.migrate --help did not answer as expected" >&2
       echo "$migrate_usage" | head -3 >&2; return 1 ;;
  esac
  echo "    python -m motet_db.migrate --help is clean (motet#27)"

  # The same claim `smoke_api` makes through /internal/health, made the only way a job
  # container can make it: this image is the *decrypt* side of the vault, so a missing
  # google-cloud-kms here means every mailbox poll fails on every run rather than one
  # consent flow failing once. Two images, one tree, two targets — and the extra could go
  # missing from either independently.
  if ! docker run --rm --entrypoint python "motet-worker:${TAG}" -c \
    'import sys; from motet_vault import kms_sdk_installed; sys.exit(0 if kms_sdk_installed() else 1)'
  then
    echo "smoke: the worker image cannot open a credential — google-cloud-kms is missing" >&2
    return 1
  fi
  echo "    google-cloud-kms is in the image (the vault's decrypt side)"
}

# --- web -------------------------------------------------------------------
build_web() {
  IMAGES+=("motet-web:${TAG}")
  docker build -t "motet-web:${TAG}" -f web/Dockerfile .
}

smoke_web() {
  local name="motet-smoke-web-$$" port base="https://api.example.test"
  CONTAINERS+=("$name")
  docker run -d --name "$name" -P -e "MOTET_API_BASE_URL=${base}" \
    "motet-web:${TAG}" >/dev/null
  port="$(host_port "$name")"

  local index
  index="$(wait_for_http "http://127.0.0.1:${port}/" "$name")"
  case "$index" in
    *'/config.js'*) ;;
    *) echo "smoke: index.html does not load /config.js" >&2; return 1 ;;
  esac
  echo "    / -> index.html loading /config.js"

  # The whole point of the image: the API origin is injected at RUN time, so this must
  # come back carrying the value the container was started with rather than the empty
  # placeholder that was built into it.
  local config
  config="$(curl -fsS --max-time 5 "http://127.0.0.1:${port}/config.js")"
  echo "    /config.js -> ${config}"
  case "$config" in
    *"apiBaseUrl: '${base}'"*) ;;
    *) echo "smoke: /config.js did not carry MOTET_API_BASE_URL" >&2; return 1 ;;
  esac

  # History fallback: a deep link must return the app, not a 404.
  curl -fsS --max-time 5 "http://127.0.0.1:${port}/episodes/ep_smoke" >/dev/null
  echo "    /episodes/ep_smoke -> index.html (history fallback)"
}

targets=("$@")
if [ ${#targets[@]} -eq 0 ]; then
  targets=(api worker web)
fi

for target in "${targets[@]}"; do
  case "$target" in
    api)    step "Build motet-api:${TAG}";    build_api
            step "Smoke motet-api";           smoke_api ;;
    worker) step "Build motet-worker:${TAG}"; build_worker
            step "Smoke motet-worker";        smoke_worker ;;
    web)    step "Build motet-web:${TAG}";    build_web
            step "Smoke motet-web";           smoke_web ;;
    *) echo "unknown image '$target' (expected: api, worker, web)" >&2; exit 2 ;;
  esac
done

printf '\n\033[1;32mBuilt and smoke-tested: %s\033[0m\n' "${targets[*]}"
