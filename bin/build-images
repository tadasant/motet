#!/usr/bin/env bash
#
# Build the four container images Cloud Run runs — motet-api, motet-worker, motet-voice,
# motet-web — and prove each one actually serves, rather than merely that it built.
#
# Separate from bin/ci because it needs a Docker daemon, and bin/ci deliberately needs
# only Postgres: a laptop without Docker must still be able to run the full check suite.
# CI runs this as its own job, so the images cannot silently stop building.
#
# It does NOT push. This repo is public and holds no cloud credential of any kind (see
# AGENTS.md); publishing is the private infrastructure repo's job.
#
#     bin/build-images              # build and smoke-test all four
#     bin/build-images api web      # a subset
#     TAG=v1 bin/build-images       # pin the tag instead of the per-run default
#     REVISION=<sha> bin/build-images   # name the build when git cannot be read
set -euo pipefail

cd "$(dirname "$0")/.."

# Tagged per run, not `local`. The self-hosted pool is shared and `ci.yml` groups
# concurrency by ref, so a PR run and a push-to-main run overlap freely on one box —
# a fixed tag means one run retags the image another is about to smoke-test.
TAG="${TAG:-local-$$}"

# The commit these images are built from, which a deployed revision reports on
# /internal/health as `revision`. The deploy passes this same value as the image tag.
#
# The smoke test both supplies it to the container and asserts the container reports it
# back, so what is on trial is the *round trip* — that the image resolves the deploy's
# variable and publishes it — rather than the value. Reading it from git anyway makes the
# printed line say something true about the artifact, and the fallback exists because a
# checkout with no git history (a tarball, an odd container) must still be able to build:
# a sentinel keeps every assertion exactly as strong without requiring a toolchain this
# script does not otherwise need. It has to satisfy `main.REVISION_PATTERN`, or health
# would refuse to publish it.
REVISION="${REVISION:-$(git rev-parse HEAD 2>/dev/null || echo smoke-no-git)}"

step() { printf '\n\033[1m==> %s\033[0m\n' "$1"; }

# Every smoke container is named and torn down on exit, including the failure path —
# a leaked container holds its port and makes the next run fail for the wrong reason.
CONTAINERS=()
IMAGES=()
cleanup() {
  for name in "${CONTAINERS[@]:-}"; do
    [ -n "$name" ] && docker rm -f "$name" >/dev/null 2>&1 || true
  done
  # Only the tags this run created. A blanket `docker image prune` here would delete a
  # co-tenant job's dangling layers off the shared runner mid-build.
  for image in "${IMAGES[@]:-}"; do
    [ -n "$image" ] && docker rmi -f "$image" >/dev/null 2>&1 || true
  done
}
trap cleanup EXIT

# The host port Docker chose for a container's 8080. Ports are assigned by the daemon
# (`-P`) rather than hardcoded: two concurrent jobs on this shared runner would otherwise
# collide on a fixed port and fail for a reason unrelated to the change under test.
host_port() {
  docker port "$1" 8080 | head -1 | sed 's/.*://'
}

# Wait for a container's HTTP endpoint, then hand back the body. Polls rather than
# sleeping a fixed interval: a cold Python start is a second on a laptop and rather
# longer on a loaded shared runner.
wait_for_http() {
  local url="$1" name="$2" attempts=60
  for _ in $(seq "$attempts"); do
    if curl -fsS --max-time 2 "$url" 2>/dev/null; then
      return 0
    fi
    if [ -z "$(docker ps -q -f "name=^${name}$")" ]; then
      echo "smoke: container ${name} exited before serving ${url}" >&2
      docker logs "$name" >&2 || true
      return 1
    fi
    sleep 1
  done
  echo "smoke: ${url} did not answer within ${attempts}s" >&2
  docker logs "$name" >&2 || true
  return 1
}

# --- api -------------------------------------------------------------------
build_api() {
  IMAGES+=("motet-api:${TAG}")
  docker build --target api -t "motet-api:${TAG}" -f Dockerfile .
}

# Health lives here and NOT on /healthz. Cloud Run's frontend answers /healthz with its
# own HTML 404 before the request reaches the container, so the endpoint was unreachable
# in both deployed environments while this smoke test passed — see motet#16.
#
# READ THIS BEFORE TRUSTING THE CHECK BELOW. It runs the image under `docker run`, where
# there is no Google frontend in front of the container. So it proves the *application*
# serves health at this path without a database and without a vendor key, and it proves
# the path is not one we already know the platform eats. It proves NOTHING about what
# Google's frontend does with any given path — that is only observable against a deployed
# revision, and it is exactly the gap that let motet#16 ship green.
API_HEALTH_PATH="/internal/health"

# Mirrors motet_api.main.PLATFORM_RESERVED_PATHS. Two copies because this is shell and
# that is Python; keep them in step. The Python one is guarded by a test, this one is the
# same claim made against a real container.
PLATFORM_RESERVED_PATHS=("/healthz" "/_ah")

smoke_api() {
  local name="motet-smoke-api-$$" port
  CONTAINERS+=("$name")
  # No DATABASE_URL and no vendor key on purpose. Health must answer without either — it
  # is what Cloud Run's startup probe hits, and a health check that needed the database
  # would report the database's health rather than the revision's.
  #
  # The vault variables ARE set, and they are the exception that earns its keep. Sealing a
  # Gmail credential imports google-cloud-kms lazily, the SDK lived behind an optional
  # extra nothing depended on, and so every image shipped without it — visible nowhere
  # until a human finished a Google consent screen and the callback raised inside a
  # request. The key path is a throwaway string; nothing here calls Cloud KMS. What is on
  # trial is whether the SDK is in the *image*, which is the one claim the workspace's own
  # venv cannot make on the image's behalf. Same lesson as motet#16.
  #
  # OTEL_RESOURCE_ATTRIBUTES carries the build label, and it is set here for the same
  # kind of reason: `service.version` is how the deploy names the commit an image was
  # built from, and /internal/health reads it back so that "is the pin bump live?" has an
  # answer. Passing it as an environment variable is not a stand-in for the deploy — it
  # IS the deploy's mechanism, and the private infrastructure repo composes this same
  # variable — so what is on trial is that the built image resolves it and reports it,
  # which is the half this repo owns. `service.name=` rides along, inert, so that what
  # the container is handed is a *list* of attributes like the deploy's rather than the
  # single pair that would never exercise the parse.
  docker run -d --name "$name" -P \
    -e MOTET_VAULT_BACKEND=kms \
    -e MOTET_VAULT_KMS_KEY=projects/smoke/locations/smoke/keyRings/smoke/cryptoKeys/smoke \
    -e MOTET_DRAIN_TRIGGER=true -e GOOGLE_CLOUD_PROJECT=smoke -e MOTET_WORKER_REGION=smoke-smoke1 \
    -e "OTEL_RESOURCE_ATTRIBUTES=service.name=motet-api,service.version=${REVISION}" \
    "motet-api:${TAG}" >/dev/null
  port="$(host_port "$name")"

  local body
  body="$(wait_for_http "http://127.0.0.1:${port}${API_HEALTH_PATH}" "$name")"
  echo "    ${API_HEALTH_PATH} -> ${body}"
  case "$body" in
    *'"status":"ok"'*) ;;
    *) echo "smoke: ${API_HEALTH_PATH} did not report ok" >&2; return 1 ;;
  esac
  case "$body" in
    *'"vault_ready":true'*) ;;
    *) echo "smoke: the image cannot seal a credential — google-cloud-kms is missing" >&2
       return 1 ;;
  esac
  # Same lesson, one seam along. Nudging the worker when the API enqueues work needs
  # `google-auth` in the *image*, and the trigger imports it when it is built rather than
  # inside the invoke — precisely so that a missing one is visible here and on
  # /internal/health, instead of being swallowed by a call whose whole contract is that it
  # never raises. The job above does not exist and nothing calls Cloud Run: what is on
  # trial is that the image can build a trigger at all.
  case "$body" in
    *'"drain_trigger":true'*) ;;
    *) echo "smoke: the image cannot trigger a worker drain — google-auth is missing" >&2
       return 1 ;;
  esac
  # The MCP server at /mcp (motet#111): the `mcp` SDK has to be in the *image*, and the
  # app registers its tools at import, so a health answer at all means it imported. The
  # count is asserted too, because a mount that registered nothing would still boot, and
  # the SDK is imported explicitly so the failure names the missing package.
  case "$body" in
    *'"mcp_tools":0,'* | *'"mcp_tools":0}'*)
      echo "smoke: the API image serves /mcp with no tools registered" >&2; return 1 ;;
    *'"mcp_tools":'*) ;;
    *) echo "smoke: ${API_HEALTH_PATH} does not report mcp_tools" >&2; return 1 ;;
  esac
  if ! docker run --rm --entrypoint python "motet-api:${TAG}" -c 'import mcp.server'; then
    echo "smoke: the API image cannot serve /mcp — the mcp SDK is missing" >&2
    return 1
  fi
  echo "    the mcp SDK is in the image, and /mcp registers its tools"
  # Non-empty AND equal to the SHA this run built. Non-empty alone would pass on a null
  # the JSON encoder wrote as the string "null", and on a field that reported some other
  # constant — neither of which answers the question the field exists for.
  case "$body" in
    *"\"revision\":\"${REVISION}\""*)
      echo "    revision -> ${REVISION} (the build this image was made from)" ;;
    *) echo "smoke: ${API_HEALTH_PATH} did not report the build's revision (${REVISION})" >&2
       return 1 ;;
  esac

  # And nothing may be served under a path the platform claims. A local 404 here is the
  # app's own JSON 404, not Google's — the point is not to reproduce the frontend, it is
  # to fail loudly if someone moves health back onto a path the frontend never forwards.
  local reserved code
  for reserved in "${PLATFORM_RESERVED_PATHS[@]}"; do
    # `|| true` rather than a bare curl: under `set -e` a connection failure inside a
    # command substitution would abort the script with curl's message instead of the one
    # below, which says what the check was actually for. curl still prints `000` itself
    # on a failure, so the empty case and the unreachable case both trip the test.
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 \
      "http://127.0.0.1:${port}${reserved}" || true)"
    echo "    ${reserved} -> ${code} (reserved by the platform; must not be ours)"
    if [ "$code" != "404" ]; then
      echo "smoke: the container answers ${reserved}, which Cloud Run 404s before it arrives" >&2
      return 1
    fi
  done

  # The generated contract has to be reachable too: it is what proves the app booted as
  # the real FastAPI application rather than as something that merely answers health.
  curl -fsS --max-time 5 "http://127.0.0.1:${port}/openapi.json" >/dev/null
  echo "    /openapi.json -> ok"

  # The podcast artwork is package data read at request time, so whether the PNG is in the
  # *image* is the same kind of claim as the SDK checks above: the workspace's venv reads it
  # from the source tree and cannot answer for the container. No database is needed.
  local artwork
  artwork="$(curl -fsS -o /dev/null -w '%{http_code} %{content_type} %{size_download}' --max-time 5 \
    "http://127.0.0.1:${port}/v1/feed/artwork.png" || true)"
  echo "    /v1/feed/artwork.png -> ${artwork}"
  # A status and a type are not the bytes: an empty file would answer both, so the size is
  # part of the claim.
  if [ "${artwork% *}" != "200 image/png" ] || [ "${artwork##* }" = "0" ]; then
    echo "smoke: the image does not serve the podcast artwork — the PNG is missing" >&2
    return 1
  fi
}

# --- worker ----------------------------------------------------------------
build_worker() {
  IMAGES+=("motet-worker:${TAG}")
  docker build --target worker -t "motet-worker:${TAG}" -f Dockerfile .
}

smoke_worker() {
  # The runner refuses an unknown queue name and exits non-zero, which makes `--help` the
  # only invocation that proves the entrypoint is wired without needing a database. It
  # also proves the queue choices, so a renamed queue shows up here.
  #
  # `2>&1` is load-bearing, and its absence is how motet#21 shipped green. The entrypoint
  # was double-executing — `__init__` imported the very module `python -m` runs, so runpy
  # executed it twice and said so — but it said so on *stderr* and still exited 0, so a
  # check that captured stdout alone could not see it. This is the only place the built
  # artifact's own interpreter and install layout are on trial; the workspace equivalent
  # is workers/tests/test_entrypoint.py.
  local usage
  usage="$(docker run --rm "motet-worker:${TAG}" --help 2>&1)"
  echo "$usage" | head -3 | sed 's/^/    /'
  case "$usage" in
    *"found in sys.modules"*)
      echo "smoke: the worker entry point double-executes itself (motet#21)" >&2; return 1 ;;
  esac
  case "$usage" in
    *integrate*assemble*script*tts*) ;;
    *) echo "smoke: worker --help did not list the Phase 1 queues" >&2; return 1 ;;
  esac

  # `motet_db`'s entry points ship in this same image — `motet-workers` depends on
  # `motet-db` — and `migrate` carried the identical defect for longer than the runner
  # did, because `bin/ci` ran it on every single run and nobody saw the warning: it goes
  # to stderr and the exit code stays 0 (motet#27). Same `2>&1`, same reason.
  #
  # Both of them, not only the one that was broken. `mint_session` is the one that
  # actually runs as a deployed Cloud Run job, which makes it the case this smoke exists
  # for: the image's own interpreter and install layout, which the workspace suite cannot
  # speak to. `db/tests/test_db_entrypoints.py` makes the same pair of claims against the
  # workspace. `--help` for each, so neither needs a database, and the expected `prog` is
  # asserted because that is what says the right module answered.
  local db_entry db_module db_prog db_usage
  for db_entry in "motet_db.migrate:motet-migrate" "motet_db.mint_session:motet-mint-session"; do
    db_module="${db_entry%%:*}"
    db_prog="${db_entry##*:}"
    db_usage="$(docker run --rm --entrypoint python "motet-worker:${TAG}" \
      -m "$db_module" --help 2>&1)"
    case "$db_usage" in
      *"found in sys.modules"*)
        echo "smoke: ${db_module} double-executes its entry point (motet#27)" >&2; return 1 ;;
    esac
    case "$db_usage" in
      "usage: ${db_prog}"*) ;;
      *) echo "smoke: python -m ${db_module} --help did not answer as expected" >&2
         echo "$db_usage" | head -3 >&2; return 1 ;;
    esac
    echo "    python -m ${db_module} --help is clean (motet#27)"
  done

  # The same claim `smoke_api` makes through /internal/health, made the only way a job
  # container can make it: this image is the *decrypt* side of the vault, so a missing
  # google-cloud-kms here means every mailbox poll fails on every run rather than one
  # consent flow failing once. Two images, one tree, two targets — and the extra could go
  # missing from either independently.
  if ! docker run --rm --entrypoint python "motet-worker:${TAG}" -c \
    'import sys; from motet_vault import kms_sdk_installed; sys.exit(0 if kms_sdk_installed() else 1)'
  then
    echo "smoke: the worker image cannot open a credential — google-cloud-kms is missing" >&2
    return 1
  fi
  echo "    google-cloud-kms is in the image (the vault's decrypt side)"
}

# --- voice -----------------------------------------------------------------
build_voice() {
  IMAGES+=("motet-voice:${TAG}")
  docker build --target voice -t "motet-voice:${TAG}" -f Dockerfile .
}

# The session socket, driven from inside a container rather than from this shell: the
# runner is not guaranteed a WebSocket client, and the image already carries one
# (`websockets`, which the realtime arm uses). Prints the first frame the server sends.
VOICE_SOCKET_CLIENT='
import json, sys
from websockets.sync.client import connect
url, origin, token, config = sys.argv[1:5]
with connect(url, origin=origin, open_timeout=10) as socket:
    socket.send(json.dumps({"type": "authenticate", "token": token, "config": json.loads(config)}))
    print(socket.recv(timeout=10))
'

smoke_voice() {
  # Two instances, one shared secret, and the session minted on one and streamed on the
  # other. That is the Cloud Run shape this service is built for — no session affinity, so
  # the socket may land anywhere — and it is the one property of the deployment a single
  # container cannot show: a secret that is not identical on every instance fails exactly
  # here, as a refused socket, and nowhere earlier.
  #
  # No vendor key and no API base URL, on purpose: health, StartSession and the socket must
  # all answer without them (fake mode). The secret and the start token are throwaway
  # strings; the origin is a name that resolves nowhere.
  local mint="motet-smoke-voice-a-$$" stream="motet-smoke-voice-b-$$" port origin="https://app.example.test"
  local secret="smoke-session-secret-$$" start_token="smoke-start-token-$$"
  CONTAINERS+=("$mint" "$stream")
  local name
  for name in "$mint" "$stream"; do
    docker run -d --name "$name" -P \
      -e "MOTET_VOICE_SESSION_SECRET=${secret}" \
      -e "MOTET_VOICE_START_SESSION_TOKEN=${start_token}" \
      -e "MOTET_VOICE_ALLOWED_ORIGINS=${origin}" \
      -e "OTEL_RESOURCE_ATTRIBUTES=service.name=motet-voice,service.version=${REVISION}" \
      "motet-voice:${TAG}" >/dev/null
  done
  port="$(host_port "$mint")"

  local body
  body="$(wait_for_http "http://127.0.0.1:${port}${API_HEALTH_PATH}" "$mint")"
  echo "    ${API_HEALTH_PATH} -> ${body:0:200}..."
  case "$body" in
    *'"status":"ok"'*'"service":"motet-voice"'*) ;;
    *) echo "smoke: voice ${API_HEALTH_PATH} did not report ok as motet-voice" >&2; return 1 ;;
  esac
  case "$body" in
    *'"session_secret_configured":true'*'"start_session_authenticated":true'*'"origins_restricted":true'*) ;;
    *) echo "smoke: voice health does not report the secret, the start token and the origins it was given" >&2
       return 1 ;;
  esac
  case "$body" in
    *"\"revision\":\"${REVISION}\""*)
      echo "    revision -> ${REVISION} (the build this image was made from)" ;;
    *) echo "smoke: voice ${API_HEALTH_PATH} did not report the build's revision (${REVISION})" >&2
       return 1 ;;
  esac

  local reserved code
  for reserved in "${PLATFORM_RESERVED_PATHS[@]}"; do
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 \
      "http://127.0.0.1:${port}${reserved}" || true)"
    echo "    ${reserved} -> ${code} (reserved by the platform; must not be ours)"
    if [ "$code" != "404" ]; then
      echo "smoke: the voice container answers ${reserved}, which Cloud Run 404s before it arrives" >&2
      return 1
    fi
  done

  # StartSession is the API's call, server to server, and it is refused without the token.
  local config='{"persona":{"name":"smoke","instructions":"smoke"},"tools":[{"name":"mark_read"}]}'
  code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 -X POST \
    -H 'Content-Type: application/json' -d "$config" \
    "http://127.0.0.1:${port}/v1/voice/sessions" || true)"
  echo "    POST /v1/voice/sessions without the start token -> ${code}"
  if [ "$code" != "401" ]; then
    echo "smoke: StartSession did not refuse a caller without the start token" >&2; return 1
  fi
  local started
  # `|| true` and no `-f`, so a refusal reaches the check below with its body rather than
  # aborting the script with curl's exit code.
  started="$(curl -sS --max-time 5 -X POST -H 'Content-Type: application/json' \
    -H "Authorization: Bearer ${start_token}" -d "$config" \
    "http://127.0.0.1:${port}/v1/voice/sessions" || true)"
  local session_path session_token
  # sed rather than a JSON parser, because this shell needs nothing but curl and Docker.
  # Both values are URL-safe by construction, so neither can contain a quote.
  session_path="$(printf '%s' "$started" | sed -n 's/.*"websocket_path":"\([^"]*\)".*/\1/p')"
  session_token="$(printf '%s' "$started" | sed -n 's/.*"session_token":"\([^"]*\)".*/\1/p')"
  if [ -z "$session_path" ] || [ -z "$session_token" ]; then
    echo "smoke: StartSession answered without a socket path and a token: ${started}" >&2
    return 1
  fi
  echo "    POST /v1/voice/sessions with the start token -> 201, ${session_path}"

  # Streamed on the OTHER instance. Waiting for its health first, so a slow second start is
  # not mistaken for a refused socket.
  wait_for_http "http://127.0.0.1:$(host_port "$stream")${API_HEALTH_PATH}" "$stream" >/dev/null
  local frame
  frame="$(docker exec "$stream" python -c "$VOICE_SOCKET_CLIENT" \
    "ws://127.0.0.1:8080${session_path}" "$origin" "$session_token" "$config" 2>&1 || true)"
  echo "    WS ${session_path} on the second instance -> ${frame:0:160}"
  case "$frame" in
    *'"type":"session_state"'*'"state":"ready"'*) ;;
    *) echo "smoke: a session minted on one instance did not open on another over a WebSocket" >&2
       docker logs "$stream" 2>&1 | tail -20 >&2 || true
       return 1 ;;
  esac

  # And a page from any other origin is refused at the handshake — the socket is the one
  # cross-origin surface the service has, and this is its control.
  # The refusal has to be the handshake's: a close before `accept` is an HTTP 403, which the
  # client raises as InvalidStatus. Any other failure — a timeout, a broken snippet — is
  # not evidence of a refusal and must not pass as one.
  frame="$(docker exec "$stream" python -c "$VOICE_SOCKET_CLIENT" \
    "ws://127.0.0.1:8080${session_path}" "https://elsewhere.example.test" "$session_token" "$config" \
    2>&1 || true)"
  case "$frame" in
    *InvalidStatus*403*) echo "    WS from an unlisted origin -> 403 at the handshake" ;;
    *) echo "smoke: the voice socket did not refuse an unlisted origin at the handshake: ${frame:0:300}" >&2
       return 1 ;;
  esac

  # Invariant 2, against the artifact: the voice image does not carry the database layer at
  # all, so there is nothing in it that could be handed a credential.
  # One interpreter that must find the service and must not find any of the four, so a
  # container that failed to start cannot pass as one where the modules are absent.
  local present
  present="$(docker run --rm --entrypoint python "motet-voice:${TAG}" -c '
import importlib.util as u
assert u.find_spec("motet_voice") is not None, "motet_voice itself is not importable"
print(" ".join(m for m in ("motet_db", "psycopg", "motet_api", "motet_workers") if u.find_spec(m)) or "none")
' 2>&1 || true)"
  if [ "$present" != "none" ]; then
    echo "smoke: the voice image carries what invariant 2 forbids, or could not be asked: ${present}" >&2
    return 1
  fi
  echo "    motet_db, psycopg, motet_api, motet_workers are absent (invariant 2)"

  # And the other direction: the MCP client **is** in the image. A session's platform tools
  # are `tools/call`s on Motet's server (motet#120), and the module that speaks them imports
  # the SDK at module scope for the `motet-vault[kms]` reason — so a build that resolved
  # without it fails here rather than inside a listener's turn.
  if ! docker run --rm --entrypoint python "motet-voice:${TAG}" -c '
import motet_voice.tools.mcp  # imports the SDK at module scope; ImportError if absent
' >/dev/null 2>&1; then
    echo "smoke: the voice image cannot import motet_voice.tools.mcp — the MCP client is missing" >&2
    return 1
  fi
  echo "    the MCP client is in the image (motet#120)"

  # Real mode, the realtime arm, and still no vendor key: health must answer, and say the
  # arm is dormant, rather than the revision failing to start. That is the state a deploy
  # is in for the minutes between the service existing and its secrets being wired.
  local real="motet-smoke-voice-real-$$"
  CONTAINERS+=("$real")
  docker run -d --name "$real" -P -e MOTET_INFERENCE_MODE=real -e MOTET_VOICE_ARM=openai_realtime \
    "motet-voice:${TAG}" >/dev/null
  body="$(wait_for_http "http://127.0.0.1:$(host_port "$real")${API_HEALTH_PATH}" "$real")"
  case "$body" in
    *'"status":"ok"'*'"inference_mode":"real"'*'"arm":"openai_realtime"'*'"arm_dormant_reason":"OPENAI_API_KEY'*) ;;
    *) echo "smoke: voice health did not answer in real mode without vendor keys" >&2; return 1 ;;
  esac
  echo "    real mode, openai_realtime arm, no vendor keys -> health ok, arm dormant"
}

# --- web -------------------------------------------------------------------
build_web() {
  IMAGES+=("motet-web:${TAG}")
  docker build -t "motet-web:${TAG}" -f web/Dockerfile .
}

smoke_web() {
  local name="motet-smoke-web-$$" port base="https://api.example.test"
  CONTAINERS+=("$name")
  docker run -d --name "$name" -P -e "MOTET_API_BASE_URL=${base}" \
    "motet-web:${TAG}" >/dev/null
  port="$(host_port "$name")"

  local index
  index="$(wait_for_http "http://127.0.0.1:${port}/" "$name")"
  case "$index" in
    *'/config.js'*) ;;
    *) echo "smoke: index.html does not load /config.js" >&2; return 1 ;;
  esac
  echo "    / -> index.html loading /config.js"

  # The whole point of the image: the API origin is injected at RUN time, so this must
  # come back carrying the value the container was started with rather than the empty
  # placeholder that was built into it.
  local config
  config="$(curl -fsS --max-time 5 "http://127.0.0.1:${port}/config.js")"
  echo "    /config.js -> ${config}"
  case "$config" in
    *"apiBaseUrl: '${base}'"*) ;;
    *) echo "smoke: /config.js did not carry MOTET_API_BASE_URL" >&2; return 1 ;;
  esac

  # History fallback: a deep link must return the app, not a 404.
  curl -fsS --max-time 5 "http://127.0.0.1:${port}/episodes/ep_smoke" >/dev/null
  echo "    /episodes/ep_smoke -> index.html (history fallback)"

  # Apple fetches this before it will let the iOS app receive a sign-in handoff. Unset, it
  # must be absent rather than index.html — Apple reads a 200 of HTML as a malformed file,
  # and the history fallback would serve exactly that.
  local aasa_status
  aasa_status="$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 \
    "http://127.0.0.1:${port}/.well-known/apple-app-site-association")"
  [ "$aasa_status" = "404" ] || {
    echo "smoke: app-site-association should 404 without MOTET_IOS_APP_ID (got ${aasa_status})" >&2
    return 1
  }
  echo "    /.well-known/apple-app-site-association -> 404 (no MOTET_IOS_APP_ID)"
}

smoke_web_applinks() {
  local name="motet-smoke-web-aasa-$$" port app_id="ABCDE12345.com.example.motet"
  CONTAINERS+=("$name")
  docker run -d --name "$name" -P -e "MOTET_API_BASE_URL=https://api.example.test" \
    -e "MOTET_IOS_APP_ID=${app_id}" "motet-web:${TAG}" >/dev/null
  port="$(host_port "$name")"
  wait_for_http "http://127.0.0.1:${port}/" "$name" >/dev/null

  # Apple requires application/json, and `default_type` in nginx.conf is exactly the kind
  # of line a later edit loses silently — the body alone would still look right.
  local content_type
  content_type="$(curl -fsS --max-time 5 -o /dev/null -w '%{content_type}' \
    "http://127.0.0.1:${port}/.well-known/apple-app-site-association")"
  case "$content_type" in
    application/json*) ;;
    *) echo "smoke: app-site-association served as '${content_type}', not application/json" >&2
       return 1 ;;
  esac

  local aasa
  aasa="$(curl -fsS --max-time 5 "http://127.0.0.1:${port}/.well-known/apple-app-site-association")"
  # `webcredentials`, which is what an ASWebAuthenticationSession https callback is verified
  # through — NOT `applinks`, which would be both insufficient for it and would route every
  # tap on a Motet URL into an app that has no handler for one.
  case "$aasa" in
    *'"webcredentials"'*"\"${app_id}\""*) ;;
    *) echo "smoke: app-site-association did not carry webcredentials for MOTET_IOS_APP_ID" >&2
       echo "$aasa" >&2; return 1 ;;
  esac
  case "$aasa" in
    *applinks*) echo "smoke: app-site-association claims applinks; see the entrypoint's note" >&2
                return 1 ;;
  esac
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import json,sys; json.load(sys.stdin)' <<<"$aasa" || {
      echo "smoke: app-site-association is not valid JSON" >&2; return 1
    }
  else
    echo "    (no python3: JSON well-formedness not checked)" >&2
  fi
  echo "    /.well-known/apple-app-site-association -> webcredentials for ${app_id}"
}

targets=("$@")
if [ ${#targets[@]} -eq 0 ]; then
  targets=(api worker voice web)
fi

for target in "${targets[@]}"; do
  case "$target" in
    api)    step "Build motet-api:${TAG}";    build_api
            step "Smoke motet-api";           smoke_api ;;
    worker) step "Build motet-worker:${TAG}"; build_worker
            step "Smoke motet-worker";        smoke_worker ;;
    voice)  step "Build motet-voice:${TAG}";  build_voice
            step "Smoke motet-voice";         smoke_voice ;;
    web)    step "Build motet-web:${TAG}";    build_web
            step "Smoke motet-web";           smoke_web
            step "Smoke motet-web app links"; smoke_web_applinks ;;
    *) echo "unknown image '$target' (expected: api, worker, voice, web)" >&2; exit 2 ;;
  esac
done

printf '\n\033[1;32mBuilt and smoke-tested: %s\033[0m\n' "${targets[*]}"
