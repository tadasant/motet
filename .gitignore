# Zimmer injects .claude/ into each session clone at prepare time (skills, hooks,
# .mcp.json, ${SECRET} substitutions). It is runtime state, never source — do not
# commit it.
.claude/

# MCP configuration (may contain API keys)
.mcp.json

# Tooling that writes into the checkout rather than outside it: some environments point
# `NPM_CONFIG_CACHE` here, and some runners drop a stderr log. Never source.
.npm-cache/
*_stderr.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Node / web
node_modules/
web/dist/
*.tsbuildinfo

# Where the local object-store backend writes audio when nothing else is configured
# (`motet_storage.store.DEFAULT_LOCAL_DIR`). `MOTET_STORAGE_BACKEND` defaults to `local`,
# so anyone who runs the API or a worker in this checkout produces one.
.motet-storage/

# Environment — never commit real values. `.env.example` is the documented shape.
.env
.env.*
!.env.example

# Infrastructure state belongs in tadasant-internal, not here — but ignore it anyway
# so an accidental `terraform` run in this tree cannot leak topology into a PR.
.terraform/
*.tfstate*
*.tfvars
!*.tfvars.example

# Swift / iOS: SwiftPM's build directory, Xcode's per-user state, and the toolchain
# `ios/bin/install-swift-toolchain` unpacks if it is pointed inside the checkout.
ios/.build/
*.xcuserdatad/
xcuserdata/
.swiftpm/

# Editors / OS
.DS_Store
.idea/
.vscode/
